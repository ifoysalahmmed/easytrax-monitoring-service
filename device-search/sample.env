# Copy to .env (git-ignored) and fill in.
PARSER_SSH=ubuntu@<parser-server>
# Folder holding id_ed25519 (the restricted search key) and known_hosts
SSH_DIR=<folder outside the repo, readable only by root>
PORT=9811
# Admin login check (defaults shown)
BACKEND_URL=https://platform-admin.easytrax.com.bd
ADMIN_URL=https://easy-admin.etrax.xyz
# 1 = SystemAdmin, 6 = Admin
ALLOWED_ROLES=1,6
