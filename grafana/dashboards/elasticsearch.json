      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GC time and CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "dfwvd0wuvbmyoc"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfwvd0wuvbmyoc"
          },
          "expr": "sum(rate(elasticsearch_jvm_gc_collection_seconds_sum[5m]))",
          "legendFormat": "GC seconds per second",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfwvd0wuvbmyoc"
          },
          "expr": "max(elasticsearch_process_cpu_percent)",
          "legendFormat": "process CPU %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Data disk used",
      "datasource": {
        "type": "prometheus",
        "uid": "dfwvd0wuvbmyoc"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
