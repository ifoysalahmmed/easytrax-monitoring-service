    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Thread pool rejections (15m)",
      "datasource": {
        "type": "prometheus",
        "uid": "dfwvd0wuvbmyoc"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfwvd0wuvbmyoc"
          },
          "expr": "sum by (type) (increase(elasticsearch_thread_pool_rejected_count[15m]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
