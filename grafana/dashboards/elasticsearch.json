      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "dfwvd0wuvbmyoc"
          },
          "expr": "100 - elasticsearch_filesystem_data_available_bytes / elasticsearch_filesystem_data_size_bytes * 100",
